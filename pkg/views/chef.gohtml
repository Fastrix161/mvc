<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Urban Tadka||Chef Page</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous"
    />
  </head>
  <body class="container">
    <nav class="navbar bg-dark border-bottom border-body" data-bs-theme="dark">
      <div class="container-fluid">
        <span class="navbar-brand mb-1 h1">Urban Tadka</span>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link" aria-current="page" href="/home"
                >Home <span class="text-muted">(Customer Page)</span></a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link" aria-cuurent="page" href="/logout">Logout</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    <div class="my-4">
      <h1 class="m-2 text-decoration-underline">
        <span class="bg-warning-subtle"> Chef Page</span>
      </h1>
    </div>

    {{ if .Orders }}
      <div class="list-group">
        {{range .Orders}}
  <div class="order-card border p-3 mb-3">
    <h5>Order #{{.Order.OrderID}} - Table {{.Order.TableNumber}}</h5>
    <p>Status: {{.Order.OrderStatus}}</p>
    <ul>
      {{range .OrderedItems}}
        <li>{{.ItemName}} - {{.Quantity}}</li>
      {{end}}
    </ul>
    {{if eq .Order.OrderStatus "In Progress"}}
      <div class="list-group-item d-flex flex-column gap-2">
        <div>
          <strong>Order ID:</strong> {{ .Order.OrderID }} &nbsp;&nbsp;
          <strong>Table Number:</strong> {{ .Order.TableNumber }}
        </div>
        <div>
          <strong>Instructions:</strong> {{ if .Order.SpecificInstruction }}{{ .Order.SpecificInstruction }}{{ else }}None{{ end }}
        </div>
        <div class="d-flex align-items-center gap-3">
          <label for="status-select-{{ .Order.OrderID }}" class="mb-0">Status:</label>
          <select id="status-select-{{ .Order.OrderID }}" class="form-select form-select-sm w-auto" {{ if ne .Order.OrderStatus `In Progress` }}disabled{{ end }}>
          <option value="In Progress" {{ if eq .Order.OrderStatus `In Progress` }}selected{{ end }}>In Progress</option>
          <option value="Completed">Completed</option>
          </select>
          <button class="btn btn-sm btn-primary" onclick="changeStatus('{{.Order.OrderID}}')">Update</button>
        </div>
      </div>
    {{ end }}
  </div>
  {{end}}
  </div>
      </div>
      {{ else }}
      <p>No orders found.</p>
      {{ end }}
    </div>
     <div
      class="modal fade"
      id="MessageModal"
      tabindex="-1"
      aria-labelledby="MessageModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title" id="MessageModalLabel"></h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">

          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-bs-dismiss="modal"
            >
              Okay
            </button>
          </div>
        </div>
      </div>
    </div>

  </body>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script>
  function changeStatus(orderID) {
    const selectEl = document.getElementById(`status-select-${orderID}`);
    const newStatus = selectEl.value;
    if (newStatus !== "Completed") {
      showModal("Only 'In Progress' orders can be marked as 'Completed'.");
      return;
    }

    fetch('/chef/changeStatus', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ order_id: orderID, status: newStatus })
    })
    .then(res => {
      if (!res.ok) {
        return res.text().then(text => { throw new Error(text); });
      }
      return res.json();
    })
    .then(data => {
      showModal(data.message || "Order status updated.");
    })
    .catch(err => {
      showModal("Failed to update status: " + err.message);
    });
  }

  function showModal(message) {
    const modalBody = document.querySelector('#MessageModal .modal-body');
    modalBody.textContent = message;

    const modal = new bootstrap.Modal(document.getElementById('MessageModal'));
    modal.show();
  }
    </script>
</html>
