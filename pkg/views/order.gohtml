{{define "order"}}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Page</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-light">
    <h1 class="m-5 text-decoration-underline">Order Page</h1>
    <div class="container">
      <div>
        <p class="fs-4">
          Order ID: {{.Order.OrderID}}<br />
          Table Number: {{.Order.TableNumber}}<br />
          Order Status:
          {{if eq .Order.OrderStatus "pending"}}
          <span
            class="text-danger text-capitalize"
            >{{.Order.OrderStatus}}</span
          >
          {{else if eq .Order.OrderStatus "placed"}}
          <span
            class="text-success text-capitalize"
            >{{.Order.OrderStatus}}</span
          >
          {{else}}
          <span class="text-capitalize">{{.Order.OrderStatus}}</span>
          {{ end }}<br />
        </p>
      </div>

      <div>
        <table class="table border table-dark table-striped-columns">
          <thead>
            <tr>
              <th scope="col">Item Name</th>
              <th scope="col">Category</th>
              <th scope="col">Price</th>
              <th scope="col">Quantity</th>
              <th scope="col">Item Total</th>
              <th scope="col" class="bg-light">Action</th>
            </tr>
          </thead>
          <tbody>
            {{
              range.OrderedItems
            }}
            {{ $itemTotal := mul .Price .Quantity }}
            <tr>
              <th scope="row">{{.ItemName}}</th>
              <th>
                <span class="text-capitalize">{{.Category}}</span>
              </th>
              <th>Rs.{{.Price}}</th>

              <th>{{.Quantity}}</th>
              <th>Rs.{{ $itemTotal }}</th>
              <th class="bg-light">
                <button
                  onclick="deleteItem('{{.ItemID}}')"
                  class="btn btn-danger"
                >
                  Delete
                </button>
              </th>
            </tr>
            {{
              end
            }}
            <tr class="fw-bold bg-secondary">
              <th scope="row">Total</th>
              <th></th>
              <th></th>
              <th></th>
              <th colspan="2">Rs. {{ .Total }}</th>
            </tr>
          </tbody>
        </table>

        <div class="d-flex justify-content-end">
          <p>
            To add/update items to the order:
            <a href="/home" class="btn">
              <button type="button" class="btn btn-primary">Go Back</button>
            </a>
          </p>
        </div>

        <div class="mt-3">
          <label class="mb-1" for="instruction">Specific Instructions:</label
          ><br />
          <input
            class="form-control"
            type="text"
            name="instruction"
            id="instruction"
            aria-label="With textarea"
          />
        </div>
      </div>
      <div class="d-flex justify-content-end mt-4">
        <button class="btn btn-success" onclick="checkoutAndPay()">
          Checkout
        </button>
      </div>
    </div>
    {{template "payment_card" .}}
<div class="modal fade" id="paymentResultModal" tabindex="-1" aria-labelledby="paymentResultLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="paymentResultLabel">Payment Status</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="paymentResultMessage">
        Payment Successful
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
      </div>
    </div>
  </div>
</div>

  </body>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
    crossorigin="anonymous"
  ></script>
  <script>
    function deleteItem(item_id) {
      fetch("/order/delete-item", {
        method: "DELETE",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          item_id: item_id,
        }),
      })
        .then((response) => response.json())
        .then((data) => {
          location.reload();
        })
        .catch((error) => {
          console.log(error);
          alert("Failed to delete item from cart.", error);
        });
    }
    function checkoutAndPay() {
  const instructions = document.getElementById("instruction").value;

  fetch("/order/checkout", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ instructions }),
  })
    .then((res) => res.json())
    .then((data) => {
      console.log("Order placed:", data.message);
      showPayment();})
    .catch((err) => {
      console.error("Checkout failed:", err);
      alert("Failed to place order.");
    });
}

function showPayment() {
  fetch("/payment")
    .then((res) => {
      console.log("Fetch status:", res.status);
      return res.json();
    })
    .then((data) => {
      const overlay = document.getElementById("paymentOverlay");
      if (data.payment) {
        document.getElementById("payment_id").value = data.payment.payment_id;
      } else {
        document.getElementById("payment_id").value = "";
        console.log("No existing payment found. New payment will be created on submit.");
      }
      overlay.style.display = "flex";
      document.body.style.overflow = "hidden";
      console.log("Payment overlay shown");
    })
    .catch((err) => {
      alert("Error fetching payment details.");
      console.error("Fetch error:", err);
    });
}

    function closePayment() {
      const overlay = document.getElementById("paymentOverlay");
      if (overlay) {
        overlay.style.display = "none";
        document.body.style.overflow = "auto";
        console.log("Payment overlay closed.");
      } else {
        console.error("No overlay found.");
      }
    }

    function submitPayment(event) {
  event.preventDefault();

  const mode = document.getElementById("mode").value;
  const paid = document.getElementById("paid").checked;
  const payment_id = document.getElementById("payment_id").value;

  if (!mode) {
    alert("Please select a payment mode");
    return;
  }

  fetch("/payment/update", {
    method: "PUT",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ payment_id, mode, status: paid }),
  })
    .then((res) => res.json())
    .then((data) => {
      const paymentResultMessage = document.getElementById("paymentResultMessage");
      paymentResultMessage.textContent = data.message || "Payment submitted.";

      const paymentResultModal = new bootstrap.Modal(document.getElementById('paymentResultModal'));
      paymentResultModal.show();

      if (paid) {
        paymentResultModal._element.addEventListener('hidden.bs.modal', () => {
          window.location.href = "/home";
        }, { once: true });
      } else {
        closePayment();
      }
    })
    .catch((err) => {
      const paymentResultMessage = document.getElementById("paymentResultMessage");
      paymentResultMessage.textContent = "Error submitting payment.";
      const paymentResultModal = new bootstrap.Modal(document.getElementById('paymentResultModal'));
      paymentResultModal.show();
      console.error(err);
    });
}

    document.addEventListener("click", function (e) {
      const overlay = document.getElementById("paymentOverlay");
      const card = overlay?.querySelector(".card");
      if (
        overlay &&
        card &&
        overlay.style.display === "flex" &&
        !card.contains(e.target) &&
        e.target.id !== "payment_id"
      ) {
        console.log("Outside card click detected. Closing payment overlay.");
        closePayment();
      }
    });
  </script>
</html>
{{ end }}
