{{define "payment_card"}}
<style>
  #paymentOverlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1050;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(5px);
    justify-content: center;
    align-items: center;
  }
</style>

<div id="paymentOverlay" style="display: none">
  <div class="card shadow-lg" style="width: 100%; max-width: 500px;">
    <div class="card-header bg-primary text-white d-flex justify-content-between">
      <span>Payment Details</span>
      <button type="button" class="btn-close btn-close-white" onclick="closePayment()" aria-label="Close"></button>
    </div>
    <div class="card-body">
      <form id="paymentForm" onsubmit="submitPayment(event)">
        <div class="mb-3">
          <label for="mode" class="form-label">Payment Mode</label>
          <select class="form-select" id="mode" required>
            <option value="">Select Mode</option>
            <option value="Cash">Cash</option>
            <option value="Card">Card</option>
            <option value="UPI">UPI</option>
            <option value="Net Banking">Net Banking</option>
          </select>
        </div>
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="paid" />
          <label class="form-check-label" for="paid">Mark as Paid</label>
        </div>
        <input type="hidden" id="payment_id" />
        <button type="submit" class="btn btn-success w-100">
          Confirm Payment of Rs. {{.Total}}
        </button>
      </form>
    </div>
  </div>
</div>
{{end}}
